<Window x:Class="WireFlow.MainDesignerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pg="http://schemas.optimax.com/wpf/xaml/propertygrid"
    xmlns:themes="clr-namespace:MaxServices.Core.Themes;assembly=MaxServices.Core"
    xmlns:dock="http://schemas.optimax.com/wpf/xaml/dock"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:wireFlowCore="clr-namespace:WireFlow;assembly=WireFlow.Core"
    xmlns:wireFlow="clr-namespace:WireFlow"
    Background="{DynamicResource NormalColorBrush}"
    Title="{Binding DesignerTitle}"
    Icon="logo.png"
    Loaded="Window_Loaded"
    Closing="Window_Closing" WindowStartupLocation="CenterScreen"
    >
    <Window.Resources>
        <Style x:Key="TooBarPanelStyle" TargetType="{x:Type ToolBarPanel}">
            <Setter Property="Background" Value="{DynamicResource ToolbarPanelBackgroundBrush}"/>
        </Style>
        <!-- A small flat button in a pane's caption, as the pane's own menu and pin buttons. Its glyph is in the palette's
             text color, the caption's: without a Foreground of its own, a button takes the system theme's black, which a
             dark caption hides. Under the mouse it shows the toolbar's frame (the palette's ButtonHover); dimmed while
             disabled, but not so far that it is lost on a dark caption. -->
        <Style x:Key="PaneCaptionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:Palette.Text}}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static themes:Palette.ButtonHover}}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static themes:Palette.ButtonHoverBorder}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static themes:Palette.ButtonPressed}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A tool glyph on its 24 x 24 grid in the text color around it, as the Tools list draws them -->
        <Style x:Key="PaneCaptionGlyph" TargetType="Path">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="StrokeThickness" Value="{StaticResource ToolGlyphStrokeThickness}"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
        </Style>
        <wireFlow:ToolGlyphConverter x:Key="ToolGlyphConverter"/>
        <!-- The toolbar, as PDFTools' (PDF Workshop's, the Organizer's ToolbarButtonStyle and ToolbarIconStyle): flat buttons
             that show a frame under the mouse, and line glyphs in the palette's ink. Its buttons take no keyboard focus, so
             that the keys stay with the page. -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:Palette.Text}}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static themes:Palette.ButtonHover}}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:Palette.ButtonHoverBorder}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static themes:Palette.ButtonPressed}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A toolbar toggle, as PDFTools' (the Imposer's ToolbarToggleStyle): flat as the buttons, tinted while on -->
        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:Palette.ButtonHover}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:Palette.ButtonHoverBorder}}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:Palette.ToggleChecked}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:Palette.ToggleCheckedBorder}}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static themes:Palette.ToggleCheckedHover}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:Palette.ToggleCheckedHoverBorder}}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource {x:Static themes:Palette.Ink}}"/>
            <Setter Property="StrokeThickness" Value="{StaticResource ToolGlyphStrokeThickness}"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:Palette.Separator}}"/>
        </Style>
        <!-- The Open button's manila folder, as PDFTools draws it -->
        <Geometry x:Key="IconOpenFolderBack">M1.5,16.5 L1.5,1.5 L8,1.5 L10,4.5 L20.5,4.5 L20.5,16.5 Z</Geometry>
        <Geometry x:Key="IconOpenFolderFront">M1.5,16.5 L1.5,12 L4.5,6.5 L22.5,6.5 L20.5,16.5 Z</Geometry>
        <SolidColorBrush x:Key="ManilaFolderBrush" Color="#FFF6E6B4"/>
        <SolidColorBrush x:Key="ManilaFolderBackBrush" Color="#FFE3D29C"/>
        <Style x:Key="OpenFolderIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource {x:Static themes:Palette.Ink}}"/>
            <Setter Property="StrokeThickness" Value="{StaticResource ToolGlyphStrokeThickness}"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>
    </Window.Resources>


    <DockPanel Name="ClientPanel">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New..." Command="{Binding NewFileCmd}"/>
                <MenuItem Header="_Open..." Command="{Binding OpenFileCmd}"/>
                <MenuItem Header="_Save" Command="{Binding SaveFileCmd}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save A_ll" Command="{Binding SaveAllCmd}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveFileAsCmd}"/>
                <MenuItem Header="Reload from File" Command="{Binding ReloadFromFileCmd}" InputGestureText="F5"/>
                <MenuItem Header="_Close" Command="{Binding CloseFileCmd}"/>
                <Separator/>
                <MenuItem Header="Export Page As..." Command="{Binding ExportPageAsCmd}"/>
                <wireFlow:RecentFileList x:Name="RecentFileList" />
                <MenuItem Header="E_xit" Command="{Binding ExitCmd}"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCmd}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCmd}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cu_t" Command="{Binding CutCmd}" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy" Command="{Binding CopyCmd}" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCmd}" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="Delete" Command="{Binding ObjectDeleteCmd}"/>
            </MenuItem>
            <!-- The panes' items follow the theme's, made as the menu opens (ViewMenuItem_SubmenuOpened) -->
            <MenuItem Header="_View" x:Name="ViewMenuItem" SubmenuOpened="ViewMenuItem_SubmenuOpened">
                <!-- Design or Navigate mode, as the toolbar's Navigate Mode button -->
                <MenuItem Header="_Navigate Mode" IsCheckable="True" IsChecked="{Binding IsNavigateMode, Mode=TwoWay}" InputGestureText="F9"/>
                <MenuItem Header="_Back" Command="{Binding NavigateBackCmd}" InputGestureText="Alt+Left"/>
                <MenuItem Header="_Forward" Command="{Binding NavigateForwardCmd}" InputGestureText="Alt+Right"/>
                <MenuItem Header="_Highlight Links" IsCheckable="True" IsChecked="{Binding HighlightLinks, Mode=TwoWay}" InputGestureText="Ctrl+L"/>
                <Separator/>
                <!-- As MaxWrite's View menu, with PDFTools' Fit Page -->
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCmd}" InputGestureText="Ctrl+="/>
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCmd}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="_Actual Size" Command="{Binding ActualSizeCmd}" InputGestureText="Ctrl+Shift+0"/>
                <MenuItem Header="Fit _Page" Command="{Binding FitPageCmd}" InputGestureText="Ctrl+0"/>
                <Separator/>
                <!-- As in PDFTools; DesignerTheme applies the choice -->
                <MenuItem Header="_Theme" x:Name="ThemeMenuItem">
                    <MenuItem Header="_System" IsCheckable="True" Tag="{x:Static themes:ThemeChoice.System}" Click="ThemeMenuItem_Click"
                              ToolTip="Follow Windows: Settings › Personalization › Colors › Choose your app mode."/>
                    <MenuItem Header="_Light" IsCheckable="True" Tag="{x:Static themes:ThemeChoice.Light}" Click="ThemeMenuItem_Click"/>
                    <MenuItem Header="_Dark" IsCheckable="True" Tag="{x:Static themes:ThemeChoice.Dark}" Click="ThemeMenuItem_Click"/>
                    <MenuItem Header="_Classic" IsCheckable="True" Tag="{x:Static themes:ThemeChoice.Classic}" Click="ThemeMenuItem_Click"
                              ToolTip="Windows' classic controls instead of the Windows 11 look. Light only."/>
                </MenuItem>
                <Separator/>
            </MenuItem>
            <MenuItem Header="Object">
                <MenuItem Header="Delete" Command="{Binding ObjectDeleteCmd}"/>
                <Separator/>
                <MenuItem Header="Grouping">
                    <MenuItem Header="Group" Command="{Binding GroupSelectedCmd}"/>
                    <MenuItem Header="Ungroup" Command="{Binding UngroupSelectedCmd}"/>
                </MenuItem>
                <MenuItem Header="Ordering">
                    <MenuItem Header="Bring to Front" Command="{Binding ObjectBringToFrontCmd}"/>
                    <MenuItem Header="Send to Back" Command="{Binding ObjectSendToBackCmd}"/>
                    <Separator/>
                    <MenuItem Header="Bring Forward" Command="{Binding ObjectBringForwardCmd}"/>
                    <MenuItem Header="Send Backward" Command="{Binding ObjectSendBackwardCmd}"/>
                </MenuItem>
                <MenuItem Header="Alignment">
                    <MenuItem Header="Center in Page" Command="{Binding CenterInPageCmd}"/>
                    <Separator/>
                    <MenuItem Header="Center Vertically" Command="{Binding AlignCentersVerticallyCmd}"/>
                    <MenuItem Header="Center Horizontally" Command="{Binding AlignCentersHorizontallyCmd}"/>
                    <Separator/>
                    <MenuItem Header="Align Top" Command="{Binding AlignTopsCmd}"/>
                    <MenuItem Header="Align Bottom" Command="{Binding AlignBottomsCmd}"/>
                    <MenuItem Header="Align Left" Command="{Binding AlignLeftsCmd}"/>
                    <MenuItem Header="Align Right" Command="{Binding AlignRightsCmd}"/>
                    <Separator/>
                    <MenuItem Header="Fill Space" Command="{Binding FillSpaceCmd}"/>
                </MenuItem>
                <MenuItem Header="Spacing">
                    <MenuItem Header="Distribute Horizontally" Command="{Binding DistributeHorizontallyCmd}"/>
                    <MenuItem Header="Distribute Vertically" Command="{Binding DistributeVerticallyCmd}"/>
                    <Separator/>
                    <MenuItem Header="Stack Horizontally" Command="{Binding StackHorizontallyCmd}"/>
                    <MenuItem Header="Stack Vertically" Command="{Binding StackVerticallyCmd}"/>
                </MenuItem>
                <MenuItem Header="Sizing">
                    <MenuItem Header="Make Same Width" Command="{Binding MakeSameWidthCmd}"/>
                    <MenuItem Header="Make Same Height" Command="{Binding MakeSameHeightCmd}"/>
                    <Separator/>
                    <MenuItem Header="Make Same Size" Command="{Binding MakeSameSizeCmd}"/>
                    <Separator/>
                    <MenuItem Header="Fill Width" Command="{Binding FillWidthCmd}"/>
                    <MenuItem Header="Fill Height" Command="{Binding FillHeightCmd}"/>
                    <Separator/>
                    <MenuItem Header="Exchange Width and Height" Command="{Binding ExchangeWidthAndHeightCmd}"/>
                </MenuItem>
                <MenuItem Header="Rotation">
                    <MenuItem Header="Rotate 90&#186; Clockwise" Command="{Binding Rotate90DegClockwiseCmd}"/>
                    <MenuItem Header="Rotate 90&#186; Anticlockwise" Command="{Binding Rotate90DegAnticlockwiseCmd}"/>
                    <Separator/>
                    <MenuItem Header="Rotate 180&#186;" Command="{Binding Rotate180DegCmd}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Options..." Click="OptionsMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="_Debug">
                <MenuItem Header="Debugger Breakpoint!" Command="{Binding DebugBreakpointCmd}"/>
                <Separator/>
                <MenuItem Header="Refresh Outline" Command="{Binding DebugPopulateLayersCmd}"/>
                <Separator/>
                <MenuItem Header="Blank Designer Tab" Command="{Binding DebugBlankCanvasCmd}"/>

            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="View Help" Command="{Binding DebugGenerateWPFColorChartCmd}"/>
                <MenuItem Header="WPF Color Chart" Command="{Binding DebugGenerateWPFColorChartCmd}"/>
                <Separator/>
                <MenuItem Header="About"/>

            </MenuItem>
        </Menu>

        <!-- The toolbar, as PDF Workshop's: under the menu, between two lines in the palette's chrome border, on the window's
             background; its buttons run the menus' commands, and are enabled as those are -->
        <Border x:Name="MainToolbar" DockPanel.Dock="Top" Background="Transparent" BorderBrush="{DynamicResource {x:Static themes:Palette.ChromeBorder}}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Height="32" Margin="8,0" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NewFileCmd}" ToolTip="New Project">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.new}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Width="Auto" Command="{Binding OpenFileCmd}" ToolTip="Open Project">
                    <StackPanel Orientation="Horizontal" Margin="6,0">
                        <Canvas Width="24" Height="18" VerticalAlignment="Center">
                            <Path Style="{StaticResource OpenFolderIconStyle}" Fill="{StaticResource ManilaFolderBackBrush}" Data="{StaticResource IconOpenFolderBack}"/>
                            <Path Style="{StaticResource OpenFolderIconStyle}" Fill="{StaticResource ManilaFolderBrush}" Data="{StaticResource IconOpenFolderFront}"/>
                        </Canvas>
                        <TextBlock Text="Open" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SaveFileCmd}" ToolTip="Save (Ctrl+S)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.save}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SaveAllCmd}" ToolTip="Save All: every document, as a new revision of the project (Ctrl+Shift+S)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.save-all}"/>
                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <!-- Design or Navigate mode, and Back and Forward through the pages visited in Navigate mode -->
                <!-- The Navigate Mode toggle, left out for now (user decision): the Navigate tool, F9 and View > Navigate Mode
                     switch the mode. To show it again, put this back:
                <ToggleButton Style="{StaticResource ToolbarToggleStyle}" IsChecked="{Binding IsNavigateMode, Mode=TwoWay}" ToolTip="Navigate Mode (F9): click links as in WireFlow Browser">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.navigate}"/>
                </ToggleButton>
                -->

                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NavigateBackCmd}" ToolTip="Back (Alt+Left)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.back}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NavigateForwardCmd}" ToolTip="Forward (Alt+Right)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.forward}"/>
                </Button>
                <ToggleButton Style="{StaticResource ToolbarToggleStyle}" IsChecked="{Binding HighlightLinks, Mode=TwoWay}" ToolTip="Highlight Links (Ctrl+L): show where the links are">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.highlight-links}"/>
                </ToggleButton>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UndoCmd}" ToolTip="Undo (Ctrl+Z)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.undo}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RedoCmd}" ToolTip="Redo (Ctrl+Y)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.redo}"/>
                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CutCmd}" ToolTip="Cut (Ctrl+X)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.cut}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CopyCmd}" ToolTip="Copy (Ctrl+C)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.copy}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PasteCmd}" ToolTip="Paste (Ctrl+V)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.paste}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ObjectDeleteCmd}" ToolTip="Delete (Del)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.delete}"/>
                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding GroupSelectedCmd}" ToolTip="Group">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.group}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UngroupSelectedCmd}" ToolTip="Ungroup">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.ungroup}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ObjectBringToFrontCmd}" ToolTip="Bring to Front">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.bring-to-front}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ObjectSendToBackCmd}" ToolTip="Send to Back">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.send-to-back}"/>
                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AlignLeftsCmd}" ToolTip="Align Left">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.align-left}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AlignCentersHorizontallyCmd}" ToolTip="Center Horizontally">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.align-center-h}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AlignRightsCmd}" ToolTip="Align Right">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.align-right}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AlignTopsCmd}" ToolTip="Align Top">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.align-top}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AlignCentersVerticallyCmd}" ToolTip="Center Vertically">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.align-center-v}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AlignBottomsCmd}" ToolTip="Align Bottom">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.align-bottom}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding FillSpaceCmd}" ToolTip="Fill Space: as far as the elements around it, or the page">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.fill-space}"/>
                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DistributeHorizontallyCmd}" ToolTip="Distribute Horizontally">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.distribute-h}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DistributeVerticallyCmd}" ToolTip="Distribute Vertically">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.distribute-v}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding MakeSameWidthCmd}" ToolTip="Make Same Width">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.same-width}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding MakeSameHeightCmd}" ToolTip="Make Same Height">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.same-height}"/>
                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <!-- Zoom, as MaxWrite's toolbar: Zoom Out, the zoom of the page in front (a click: Actual Size), Zoom In; and Fit Page -->
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ZoomOutCmd}" ToolTip="Zoom Out (Ctrl+-)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.zoom-out}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ActualSizeCmd}" ToolTip="Actual Size (Ctrl+Shift+0)" Width="48" Padding="2,0">
                    <TextBlock Text="{Binding CurrentDesigner.Designer.Zoom, StringFormat={}{0:0%}, FallbackValue=100%}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ZoomInCmd}" ToolTip="Zoom In (Ctrl+=)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.zoom-in}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding FitPageCmd}" ToolTip="Fit Page (Ctrl+0)">
                    <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolGlyph.fit-page}"/>
                </Button>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Height="22" Background="{DynamicResource ToolbarPanelBackgroundBrush}">
            <!-- As MaxPad's: Modified while the page, layout or part in front has changes not saved -->
            <StatusBarItem Padding="6,0">
                <TextBlock Text="{Binding DocumentState}" MinWidth="60" ToolTip="Whether the page, layout or part in front has changes not saved"/>
            </StatusBarItem>
        </StatusBar>


        <dock:DockingManager
            Name="DockingManager"
            AllowMixedOrientation="True"
            BorderThickness="0"
            Background="Transparent"
            >

            <!-- A pane's title; the Outline's and the Pages' have buttons for their commands at its right end -->
            <dock:DockingManager.AnchorableTitleTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True">
                        <StackPanel x:Name="OutlineButtons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,2,0" Visibility="Collapsed">
                            <Button Style="{StaticResource PaneCaptionButton}" ToolTip="Add a layer above the current one"
                                    Command="{Binding DataContext.AddLayerCmd, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource ToolGlyph.layer-add}" Style="{StaticResource PaneCaptionGlyph}"/></Viewbox>
                            </Button>
                            <Button Style="{StaticResource PaneCaptionButton}" ToolTip="Delete the selected objects, or the layer chosen"
                                    Command="{Binding DataContext.OutlineDeleteCmd, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource ToolGlyph.delete}" Style="{StaticResource PaneCaptionGlyph}"/></Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="PagesButtons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,2,0" Visibility="Collapsed">
                            <Button Style="{StaticResource PaneCaptionButton}" ToolTip="Move the selected page up; the first page is where the project starts"
                                    Command="{Binding DataContext.MovePageUpCmd, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource ToolGlyph.move-up}" Style="{StaticResource PaneCaptionGlyph}"/></Viewbox>
                            </Button>
                            <Button Style="{StaticResource PaneCaptionButton}" ToolTip="Move the selected page down"
                                    Command="{Binding DataContext.MovePageDownCmd, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource ToolGlyph.move-down}" Style="{StaticResource PaneCaptionGlyph}"/></Viewbox>
                            </Button>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ContentId}" Value="outline">
                            <Setter TargetName="OutlineButtons" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ContentId}" Value="pages">
                            <Setter TargetName="PagesButtons" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </dock:DockingManager.AnchorableTitleTemplate>

            <dock:DockingManager.DocumentHeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconSource}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Title}"  Margin="0,0,5,0" FontSize="15" Foreground="{DynamicResource LightLightColorBrush}"/>
                        <!-- Changes not saved: a dot after the name, as MaxPad's tabs (MaxServices.Core's TabStripItem) have it -->
                        <Ellipse x:Name="ModifiedMark" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FFC05A00"
                                 ToolTip="Modified" Visibility="Collapsed"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                            <Setter TargetName="ModifiedMark" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </dock:DockingManager.DocumentHeaderTemplate>


            <dock:LayoutRoot x:Name="LayoutRoot">

                <dock:LayoutPanel Orientation="Horizontal">

                    <dock:LayoutAnchorablePaneGroup DockWidth="300"  x:Name="LeftPane" Orientation="Vertical">


                        <dock:LayoutAnchorablePane DockHeight="*">
                            <dock:LayoutAnchorable ContentId="tools" Title="Tools" CanHide="True" CanClose="False">
                                <Grid>
                                    <!-- The background of Pages (EditableListBox's style), in every theme -->
                                    <ListBox Name="Tools" Padding="3" BorderThickness="0" Background="{DynamicResource ListBackgroundBrush}" SelectedItem="{Binding Path=SelectedDrawingTool,Mode=OneWay}" SelectedIndex="{Binding SelectedToolIndex}"
                                        ItemsSource="{Binding DrawingTools}">
                                        <ListBox.Resources>
                                            <!-- The tool's glyph, drawn on its 24 x 24 grid in the row's text color, and its title -->
                                            <DataTemplate DataType="{x:Type wireFlow:DrawingTool}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Path Width="24" Height="24" Data="{Binding GlyphGeometry}" StrokeThickness="{StaticResource ToolGlyphStrokeThickness}"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.Resources>
                                    </ListBox>
                                </Grid>
                            </dock:LayoutAnchorable>

                            <dock:LayoutAnchorable Title="History" ContentId="history" CanHide="True" CanClose="False">
                                <DockPanel>
                                    <!-- The saved versions of the page, layout or part in front, the latest first -->
                                    <ListBox x:Name="ListBoxHistory" BorderThickness="0" ItemsSource="{Binding History}"
                                             MouseDoubleClick="ListBoxHistory_MouseDoubleClick"
                                             ToolTip="Double-click a version to make the page what it was then. Undo takes it back."
                                             ItemTemplate="{StaticResource ListOfNamesDataTemplate}">
                                    </ListBox>
                                </DockPanel>
                            </dock:LayoutAnchorable>

                        </dock:LayoutAnchorablePane>

                        <dock:LayoutAnchorablePane DockHeight="2*">
                            <dock:LayoutAnchorable Title="Pages" ContentId="pages" CanHide="True" CanClose="False">


                                <DockPanel>
                                    <ToolBarPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}"
                                                Margin="1,0,2,0" ToolTip="Add New Page" Command="{Binding NewPageCmd}">
                                            <Image Source="/Images/plus.png" Width="14" Height="14"/>
                                        </Button>
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}"
                                                Margin="1,0,2,0" ToolTip="Delete Page" Command="{Binding DeletePageCmd}">
                                            <Image Source="/Images/minus.png" Width="14" Height="14"/>
                                        </Button>
                                    </ToolBarPanel>


                                    <wireFlow:EditableListBox x:Name="ListBoxPages" BorderThickness="0" Padding="0"
                                         ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPageName}" MouseDoubleClick="ListBoxPages_MouseDoubleClick"
                                         ItemTemplate="{StaticResource ListOfPagesDataTemplate}" SelectionChanged="ListBoxPages_SelectionChanged"
                                         PreviewMouseLeftButtonDown="ListBoxPages_PreviewMouseLeftButtonDown" >
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename" Command="{Binding PagesRenamePageCmd}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                    </wireFlow:EditableListBox>

                                </DockPanel>



                            </dock:LayoutAnchorable>

                            <dock:LayoutAnchorable Title="Layouts" ContentId="layouts" CanHide="True" CanClose="False">
                                <DockPanel>
                                    <ToolBarPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}"
                                                Command="{Binding NewLayoutCmd}"
                                                Margin="1,0,2,0" ToolTip="Add New Layout">
                                            <Image Source="/Images/plus.png" Width="14" Height="14"/>
                                        </Button>
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}"
                                                Command="{Binding DeleteLayoutCmd}"
                                                Margin="1,0,2,0" ToolTip="Delete Layout">
                                            <Image Source="/Images/minus.png" Width="14" Height="14"/>
                                        </Button>
                                    </ToolBarPanel>
                                    <ListBox Name="ListBoxLayouts" BorderThickness="0"
                                             ItemsSource="{Binding Layouts}"
                                             SelectedItem="{Binding CurrentLayoutName}"
                                             ItemTemplate="{StaticResource ListOfPagesDataTemplate}"
                                             MouseDoubleClick="ListBoxLayouts_MouseDoubleClick">
                                    </ListBox>
                                </DockPanel>
                            </dock:LayoutAnchorable>


                            <dock:LayoutAnchorable Title="Parts" ContentId="parts" CanHide="True" CanClose="False">
                                <DockPanel>
                                    <ToolBarPanel DockPanel.Dock="Top" Background="{DynamicResource ToolbarPanelBackgroundBrush}" Orientation="Horizontal">
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}" Margin="1,0,2,0"
                                                ToolTip="Add New Part" Command="{Binding NewPartCmd}">
                                            <Image Source="/Images/plus.png" Width="14" Height="14"/>
                                        </Button>
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}" Margin="1,0,2,0"
                                                ToolTip="Delete Part" Command="{Binding DeletePartCmd}">
                                            <Image Source="/Images/minus.png" Width="14" Height="14"/>
                                        </Button>
                                    </ToolBarPanel>
                                    <ListBox  Name="ListBoxParts" Padding="3" BorderThickness="0"
                                          ItemsSource="{Binding Parts}"
                                              SelectedItem="{Binding CurrentPartName}"
                                          ItemTemplate="{StaticResource ListOfNamesDataTemplate}"
                                          MouseDoubleClick="ListBoxParts_MouseDoubleClick">
                                    </ListBox>
                                </DockPanel>
                            </dock:LayoutAnchorable>


                            <dock:LayoutAnchorable Title="Images" ContentId="images" CanHide="True" CanClose="False">
                                <DockPanel>
                                    <ToolBarPanel DockPanel.Dock="Top" Background="{DynamicResource ToolbarPanelBackgroundBrush}" Orientation="Horizontal">
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}" Margin="1,0,2,0"
                                                ToolTip="Add Image to Project" Command="{Binding ImportImageCmd}">
                                            <Image Source="/Images/plus.png" Width="14" Height="14"/>
                                        </Button>
                                        <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{DynamicResource DarkDarkDarkBrush}" Margin="1,0,2,0"
                                                ToolTip="Delete Image from Project" Command="{Binding DeleteImageCmd}">
                                            <Image Source="/Images/minus.png" Width="14" Height="14"/>
                                        </Button>
                                    </ToolBarPanel>
                                    <ListBox Name="ListBoxImages" BorderThickness="0"
                                             ItemsSource="{Binding Images}" SelectionMode="Extended"
                                               SelectedItem="{Binding CurrentImageName}"
                                          ItemTemplate="{StaticResource ListOfNamesDataTemplate}">
                                    </ListBox>
                                </DockPanel>

                            </dock:LayoutAnchorable>

                        </dock:LayoutAnchorablePane>

                    </dock:LayoutAnchorablePaneGroup>




                    <dock:LayoutDocumentPaneGroup>
                        <dock:LayoutDocumentPane x:Name="DocumentPane" ShowHeader="True" PropertyChanged="DocumentPane_PropertyChanged">
                            <!-- Designer Documents Inserted Here at Runtime -->
                        </dock:LayoutDocumentPane>
                    </dock:LayoutDocumentPaneGroup>



                    <dock:LayoutAnchorablePaneGroup DockWidth="300" x:Name="RightPane" Orientation="Vertical">
                        <dock:LayoutAnchorablePane>
                            <dock:LayoutAnchorable ContentId="outline" Title="Outline"  CanHide="True" CanClose="False">

                                <!-- Virtualizing: only the entries in view have items. Standard, not Recycling, mode, so that an entry collapsed by hand does not pass that on to another -->
                                <!-- The background of Pages (EditableListBox's style), in every theme -->
                                <TreeView Name="Outline" BorderThickness="0" Background="{DynamicResource ListBackgroundBrush}" ItemsSource="{Binding LayerOutline}" SelectedItemChanged="Outline_SelectedItemChanged"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add _Layer" Command="{Binding AddLayerCmd}"/>
                                            <MenuItem Header="_Delete" Command="{Binding OutlineDeleteCmd}"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.Resources>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="True" />
                                            <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                                            <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                                        </Style>

                                        <!-- An entry's eye or padlock: a caption button, faint while it has nothing to tell (the element shows,
                                             or is free), and plain while it has (Tag "On": the element is hidden, or locked) or under the mouse -->
                                        <Style x:Key="OutlineStateButton" TargetType="Button" BasedOn="{StaticResource PaneCaptionButton}">
                                            <Setter Property="Opacity" Value="0.3"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="Tag" Value="On">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>

                                        <!-- The eye and the padlock of an entry of the page's own: a click shows or hides its element or layer, or
                                             locks or unlocks it. Each shows how the element is, through what holds it too (an element of a hidden
                                             layer has the struck-through eye, faint, as it is not itself hidden) -->
                                        <DataTemplate x:Key="OutlineStateButtons">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="Eye" Style="{StaticResource OutlineStateButton}" ToolTip="Show or hide"
                                                        CommandParameter="{Binding}" Command="{Binding DataContext.OutlineToggleVisibleCmd, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                                    <Viewbox Width="14" Height="14"><Path Data="{Binding EyeGlyph, Converter={StaticResource ToolGlyphConverter}}" Style="{StaticResource PaneCaptionGlyph}"/></Viewbox>
                                                </Button>
                                                <Button x:Name="Padlock" Style="{StaticResource OutlineStateButton}" ToolTip="Lock or unlock: a locked object cannot be changed"
                                                        CommandParameter="{Binding}" Command="{Binding DataContext.OutlineToggleLockedCmd, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                                    <Viewbox Width="14" Height="14"><Path Data="{Binding LockGlyph, Converter={StaticResource ToolGlyphConverter}}" Style="{StaticResource PaneCaptionGlyph}"/></Viewbox>
                                                </Button>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                                    <Setter TargetName="Eye" Property="Tag" Value="On"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Locked}" Value="True">
                                                    <Setter TargetName="Padlock" Property="Tag" Value="On"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>

                                        <!-- An element selected in the Designer is highlighted: the theme's text color, faint, behind its entry.
                                             What an entry shows ends before its eye and padlock (the pin's Room), its name cut short with an ellipsis -->
                                        <HierarchicalDataTemplate DataType="{x:Type wireFlowCore:UICanvasProxy}" ItemsSource="{Binding Elements}">
                                            <Grid>
                                                <Border x:Name="Highlight" Background="{DynamicResource LightLightColorBrush}" CornerRadius="2" Margin="-2,0" Opacity="0"/>
                                                <DockPanel HorizontalAlignment="Left" MaxWidth="{Binding Room, ElementName=Pin}">
                                                    <!-- The tool glyph of the entry's kind, as the Tools list draws it: in the row's text color -->
                                                    <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Path Width="24" Height="24" Data="{Binding Glyph, Converter={StaticResource ToolGlyphConverter}}"
                                                              StrokeThickness="{StaticResource ToolGlyphStrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                                    </Viewbox>
                                                    <TextBlock DockPanel.Dock="Right" Foreground="Gray">
                                                        <Run Text=" ["/><Run Text="{Binding Path=Elements.Count,Mode=OneWay}"/><Run Text="]"/>
                                                    </TextBlock>
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Path=Type,Mode=OneWay}"/>
                                                        <Run Text=":"/>
                                                        <Run Text="{Binding Path=ContentInfo,Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <!-- Its eye and padlock, at the pane's right edge -->
                                                <wireFlow:RightEdgePin x:Name="Pin" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OutlineStateButtons}"/>
                                                </wireFlow:RightEdgePin>
                                            </Grid>
                                            <HierarchicalDataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasState}" Value="True">
                                                    <Setter TargetName="Pin" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter TargetName="Highlight" Property="Opacity" Value="0.22"/>
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>

                                        <HierarchicalDataTemplate DataType="{x:Type wireFlowCore:UIElementProxy}">
                                            <Grid>
                                                <Border x:Name="Highlight" Background="{DynamicResource LightLightColorBrush}" CornerRadius="2" Margin="-2,0" Opacity="0"/>
                                                <DockPanel HorizontalAlignment="Left" MaxWidth="{Binding Room, ElementName=Pin}">
                                                    <!-- The tool glyph of the entry's kind, as the Tools list draws it: in the row's text color -->
                                                    <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Path Width="24" Height="24" Data="{Binding Glyph, Converter={StaticResource ToolGlyphConverter}}"
                                                              StrokeThickness="{StaticResource ToolGlyphStrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                                    </Viewbox>
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Path=Type,Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Path=ContentInfo,Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <!-- Its eye and padlock, at the pane's right edge -->
                                                <wireFlow:RightEdgePin x:Name="Pin" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OutlineStateButtons}"/>
                                                </wireFlow:RightEdgePin>
                                            </Grid>
                                            <HierarchicalDataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasState}" Value="True">
                                                    <Setter TargetName="Pin" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter TargetName="Highlight" Property="Opacity" Value="0.22"/>
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>

                                    </TreeView.Resources>

                                </TreeView>

                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                        <dock:LayoutAnchorablePane>
                            <dock:LayoutAnchorable ContentId="properties" Title="Properties" CanHide="True" CanClose="False" AutoHideWidth="240" >
                                <pg:PropertyGrid
                                    x:Name="PropertyGrid"
                                    NameColumnWidth="160"
                                    BorderThickness="0"
                                    SelectedObject="{Binding CurrentProperties}"
                                    Background="{DynamicResource ListBackgroundBrush}"
                                    Foreground="{DynamicResource LightLightColorBrush}"
                                    CategoryBackground="{DynamicResource DarkDarkDarkBrush}"
                                    FilterWatermark="Filter Properties"/>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>

                    </dock:LayoutAnchorablePaneGroup>
                </dock:LayoutPanel>

            </dock:LayoutRoot>
        </dock:DockingManager>



    </DockPanel>

</Window>
