<Window x:Class="WireFlow.Views.SelectImageDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WireFlow.Views"
        mc:Ignorable="d"
        Title="Select an Image" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <ToolBarPanel DockPanel.Dock="Top" Background="{StaticResource ToolbarPanelBackgroundBrush}" Orientation="Horizontal">
                <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{StaticResource DarkDarkDarkBrush}" Margin="1,0,2,0"
                                                ToolTip="Add Image to Project" Command="{Binding ImportImageCmd}">
                    <Image Source="/Images/plus.png" Width="14" Height="14"/>
                </Button>
                <Button Focusable="False" ToolBar.OverflowMode="Never" Background="{StaticResource DarkDarkDarkBrush}" Margin="1,0,2,0"
                                                ToolTip="Delete Image from Project" Command="{Binding DeleteImageCmd}">
                    <Image Source="/Images/minus.png" Width="14" Height="14"/>
                </Button>
            </ToolBarPanel>
            <ListBox Name="ListBoxImages" BorderThickness="0" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}"
                  ItemTemplate="{StaticResource ListOfNamesDataTemplate}" MouseDoubleClick="ListBoxImages_MouseDoubleClick">
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="1" HorizontalAlignment="Stretch" Style="{StaticResource {x:Type Panel}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,20,0">
                <Button Content="OK" Width="42" Margin="5" Click="ButtonOK_Click"/>
                <Button Content="Cancel" Width="42" Margin="5" Click="ButtonCancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
