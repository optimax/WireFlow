<Application x:Class="WireFlow.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Startup="Application_Startup" >
    <Application.Resources>

        <ResourceDictionary>
            <!-- WPF's Fluent theme, light or dark, with Core's styles over it, as in PDFTools: Core's AppTheme swaps the
                 first dictionary for the chosen theme's and puts its palette after it (DesignerTheme) -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaxServices.Core;component/Themes/FluentStyles.xaml" />
                <ResourceDictionary Source="Xaml/Cursors.xaml" />
                <ResourceDictionary Source="Classes/DesignerContextMenu.xaml" />
                <ResourceDictionary Source="pack://application:,,,/OptimaxTools.Dock.Themes.Metro;component/Theme.xaml" />
                <ResourceDictionary Source="Xaml/GlobalStyles.xaml" />
                <ResourceDictionary Source="Xaml/GlobalTemplates.xaml" />
                <ResourceDictionary Source="Xaml/ToolGlyphs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
</Application>
