<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xcad="http://schemas.xceed.com/wpf/xaml/avalondock"
                    xmlns:wireFlow="clr-namespace:WireFlow">

    <!--Custom Colors -->
    <Color x:Key="DarkDarkDarkColor">#111111</Color>

    <Color x:Key="DarkDarkColor">#696969</Color>
    <Color x:Key="NormalColor">#222</Color>
    <Color x:Key="DarkColor">Gray</Color>
    <Color x:Key="LightColor">#939393</Color>
    <Color x:Key="DisabledLightColor">#AAAAAA</Color>
    <Color x:Key="LightLightColor">LightGray</Color>
    <Color x:Key="GlowColor">White</Color>


    <Color x:Key="ItemsBackgroundColor">#2e2e2e</Color>
    <Color x:Key="DisabledDarkColor">#888888</Color>
    <Color x:Key="ListBackgroundColor">#333</Color>
    <Color x:Key="DesignerBackgroundColor">#222222</Color>
    <Color x:Key="DesignerCanvasColor">#393939</Color>
    <Color x:Key="SeparatorColor">#3b3b3b</Color>
    <Color x:Key="ToolbarPanelBackgroundColor">#444444</Color>

    <Color x:Key="YellowColor" >#FFD700</Color>
    <Color x:Key="GreenColor" >#3c9b3c</Color>


    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
    <SolidColorBrush x:Key="LightColorBrush" Color="{StaticResource LightColor}"/>
    <SolidColorBrush x:Key="LightLightColorBrush" Color="{StaticResource LightLightColor}"/>
    <SolidColorBrush x:Key="GlowColorBrush" Color="{StaticResource GlowColor}"/>
    <SolidColorBrush x:Key="NormalColorBrush" Color="{StaticResource NormalColor}"/>
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="LightGray"/>
    <SolidColorBrush x:Key="GroupBoxHeaderBrush" Color="White"/>
    <SolidColorBrush x:Key="DarkDarkBrush" Color="{StaticResource DarkDarkColor}" />
    <SolidColorBrush x:Key="DarkDarkDarkBrush" Color="{StaticResource DarkDarkDarkColor}" />
    <SolidColorBrush x:Key="DesignerCanvasBrush" Color="{StaticResource DesignerCanvasColor}" />
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="{StaticResource ListBackgroundColor}" />
    <SolidColorBrush x:Key="ToolbarPanelBackgroundBrush" Color="{StaticResource ToolbarPanelBackgroundColor}" />
    <SolidColorBrush x:Key="DesignerBackgroundBrush" Color="{StaticResource DesignerBackgroundColor}" />



    <!-- Outer Border Brushes -->
    <LinearGradientBrush x:Key="ControlOuterBorderBrush" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="0"/>
        <GradientStop Color="{StaticResource LightLightColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ControlOuterBorderVerticalBrush" EndPoint="0,0" StartPoint="1,0">
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="0"/>
        <GradientStop Color="{StaticResource LightLightColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ControlHoverOuterBorderBrush" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="0"/>
        <GradientStop Color="{StaticResource LightLightColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ControlHoverOuterBorderVerticalBrush" EndPoint="0,0" StartPoint="1,0">
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="0"/>
        <GradientStop Color="{StaticResource LightLightColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource DarkDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PressedControlOuterBorderBrush" Color="{StaticResource DarkDarkDarkColor}"/>

    <LinearGradientBrush x:Key="DisabledControlOuterBorderBrush" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="{StaticResource DisabledDarkColor}" Offset="0"/>
        <GradientStop Color="{StaticResource LightLightColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource DisabledDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <!--Foreground Brushes-->
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="{StaticResource LightLightColor}" Opacity="1"/>
    <SolidColorBrush x:Key="ControlHoverForegroundBrush" Color="{StaticResource GlowColor}" Opacity="1"/>
    <SolidColorBrush x:Key="PressedControlForegroundBrush" Color="{StaticResource LightLightLightColor}" Opacity="1"/>
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="{StaticResource DisabledLightColor}" Opacity="1"/>

    <!--Menu Background-->
    <LinearGradientBrush x:Key="MenuControlOuterBackground" EndPoint="0,1" StartPoint="0,0" Opacity="1">
        <GradientStop Color="{StaticResource LightColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NormalColor}" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="MenuControlInnerBackground" Opacity="0.5" Center="0.04,0.1" RadiusX="1.1" RadiusY="1.65" GradientOrigin="0.012,0.03">
        <GradientStop />
        <GradientStop Color="Black" Offset="1" />
    </RadialGradientBrush>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{StaticResource DarkDarkBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}"/>
        <!--<Setter Property="FontSize" Value="{DynamicResource {x:Static SystemFonts.MenuFontSizeKey}}"/>-->
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="Foreground" Value="{StaticResource LightLightColorBrush}"/>
    </Style>


    <Style x:Key="MainMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{StaticResource DarkDarkBrush}"/>
        <!--<Setter Property="FontSize" Value="{DynamicResource {x:Static SystemFonts.MenuFontSizeKey}}"/>-->
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="Foreground"  Value="{StaticResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>


    <Style TargetType="{x:Type ListBox}">
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="Foreground" Value="{StaticResource LightLightColorBrush}"/>
        <Setter Property="Background" Value="{StaticResource ListBackgroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type wireFlow:EditableListBox}">
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="Foreground" Value="{StaticResource LightLightColorBrush}"/>
        <Setter Property="Background" Value="{StaticResource ListBackgroundBrush}"/>
    </Style>



    <Style TargetType="{x:Type TreeView}">
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="Background" Value="{StaticResource ListBackgroundBrush}"/>
    </Style>


    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource LightLightColorBrush}"/>
    </Style>



    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{StaticResource DarkDarkBrush}"/>
    </Style>


    <Style TargetType="{x:Type xcad:AnchorablePaneTitle}">
        <Setter Property="Foreground" Value="{StaticResource LightLightColorBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="5,0,5,5"/>
    </Style>


    <Style TargetType="{x:Type ToolBarPanel}">
        <Setter Property="Background" Value="{StaticResource ToolbarPanelBackgroundBrush}"/>
    </Style>


    <Style x:Name="DarkBackground" TargetType="{x:Type Panel}">
        <Setter Property="Background" Value="{StaticResource ToolbarPanelBackgroundBrush}"/>
    </Style>



</ResourceDictionary>
