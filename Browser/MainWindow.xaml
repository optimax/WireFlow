<Window x:Class="WireFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wireFlow="clr-namespace:WireFlow;assembly=WireFlow.Core"
        Title="{Binding WindowTitle}"
        Height="900" Width="1200"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrushOne" StartPoint="0,0.5" EndPoint="1,0.5" Opacity="0.5">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Silver" Offset="1" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BrushTwo" StartPoint="0,0.5" EndPoint="1,0.5" Opacity="0.5">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="Maroon" Offset="0" />
                    <GradientStop Color="Silver" Offset="1" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>


        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

    </Window.Resources>


    <Window.InputBindings>
        <KeyBinding Command="{Binding ReloadFileCommand}" Key="F5" />
        <KeyBinding Command="{Binding RefreshViewCommand}" Key="F6" />
        <KeyBinding Command="{Binding NavigateBackCommand}" Key="Back" />
        <KeyBinding Command="{Binding NavigateForwardCommand}" Key="Tab" />
    </Window.InputBindings>


    <Grid Name="MainGrid" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>


        <Menu Background="LightGray" FontSize="15">
            <MenuItem Header="File" Visibility="Visible">
                <MenuItem Header="New" Click="MenuItem_New_Click"/>
                <MenuItem Header="Open..." Click="MenuItem_Open_Click"/>
                <MenuItem Header="Save As..." Click="MenuItem_SaveAs_Click"/>
                <MenuItem Header="Refresh Document" Command="{Binding ReloadFileCommand}" InputGestureText="F5"/>

                <Separator/>
                <MenuItem Header="Exit"  Click="MenuItem_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Reload View" Command="{Binding RefreshViewCommand}" InputGestureText="F6"/>
                <Separator/>
                <MenuItem Header="Fit In Window" Click="MenuItem_FitInWindow_Click" InputGestureText="Home"/>
                <MenuItem Header="Reset Zoom &amp; Position" Click="MenuItem_ViewReset_Click" InputGestureText="End"/>
                <Separator/>
                <MenuItem Header="Show Page Title" IsCheckable="True" IsChecked="{Binding ShowNodeTitle}"/>
                <Separator/>
                <MenuItem Header="Show Grid" Click="MenuItem_ViewToggleGrid_Click" IsCheckable="True" IsChecked="{Binding ShowGrid}" InputGestureText="G"/>
                <MenuItem Header="Show Golden Ratios" Click="MenuItem_ViewToggleGrid_Click" IsCheckable="True" IsChecked="{Binding ShowGoldenRatios}"/>
                <MenuItem Header="Show Rule of Thirds" Click="MenuItem_ViewToggleGrid_Click" IsCheckable="True" IsChecked="{Binding ShowThirds}"/>
                <MenuItem Header="Show 4x4 Grid" Click="MenuItem_ViewToggleGrid_Click" IsCheckable="True" IsChecked="{Binding Show4x4Grid}"/>
                <MenuItem Header="Show 5x5 Grid" Click="MenuItem_ViewToggleGrid_Click" IsCheckable="True" IsChecked="{Binding Show5x5Grid}"/>
                <MenuItem Header="Show 7x7 Grid" Click="MenuItem_ViewToggleGrid_Click" IsCheckable="True" IsChecked="{Binding Show7x7Grid}"/>
                <MenuItem Header="Show 12x12 Grid" Click="MenuItem_ViewToggleGrid_Click" IsCheckable="True" IsChecked="{Binding Show12x12Grid}"/>
            </MenuItem>

            <MenuItem Header="Debug">
                <MenuItem Header="Save History As..." Click="MenuItem_SaveHistoryAs_Click"/>
                <MenuItem Header="Clear History" Click="MenuItem_ClearHistory_Click"/>
                <MenuItem Header="Test Box" Click="MenuItem_TestBox_Click"/>
                <MenuItem Header="Test Window" Click="MenuItem_TestWindow_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1" Margin="0,1" Background="#666">
            <ToolBar Background="#666" ToolBarTray.IsLocked="True" SizeChanged="ToolBar_SizeChanged">
                <Button Content="Home" Foreground="LightGray" ToolBar.OverflowMode="Never"/>
                <Button Content="Back" Foreground="LightGray" ToolBar.OverflowMode="Never"/>
                <Button Content="Forward" Foreground="LightGray" ToolBar.OverflowMode="Never"/>
            </ToolBar>
        </ToolBarTray>

        <DockPanel Grid.Row="2">
            <Grid DockPanel.Dock="Top" Height="40" VerticalAlignment="Top" Opacity="0.5" Visibility="{Binding ShowNodeTitle, Converter={StaticResource BoolToVisConverter}, FallbackValue=Visible}">
                <TextBlock Foreground="White" FontSize="24" TextAlignment="Center" Background="#FF363636" Text="{Binding NodeTitle}"></TextBlock>
            </Grid>

            <wireFlow:DesignerPanel x:Name="Viewer" ClipToBounds="True" Background="#222"/>

        </DockPanel>


        <StatusBar Height="100" Grid.Row="3" />



    </Grid>



</Window>

