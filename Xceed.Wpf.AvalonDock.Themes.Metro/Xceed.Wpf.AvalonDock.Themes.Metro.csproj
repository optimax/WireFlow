<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Xceed.Wpf.AvalonDock.Themes.Metro</RootNamespace>
    <AssemblyName>Xceed.Wpf.AvalonDock.Themes.Metro</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>sn.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Images\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package also ships an Xceed.Wpf.AvalonDock.Themes.Metro.dll, which has the same name as this project: take only AvalonDock itself. -->
    <PackageReference Include="Extended.Wpf.Toolkit" Version="2.9.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" NoWarn="NU1701" />
    <Reference Include="Xceed.Wpf.AvalonDock">
      <HintPath>$(PkgExtended_Wpf_Toolkit)\lib\net40\Xceed.Wpf.AvalonDock.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
