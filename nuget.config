<?xml version="1.0" encoding="utf-8"?>
<!-- WireFlow's own package source, beside the usual ones: LocalPackages, kept in the repository, holds packages of our own
     code made elsewhere, so that WireFlow builds by itself. Today: MaxServices.Core (Optimax.Shared.Lib), for the themes
     PDFTools uses too, OptimaxTools.Options, the Options dialog of MarkdownTools' and PDFTools' programs, and
     OptimaxTools.FontSelection, the font dialog of MarkdownTools' programs. -->
<configuration>
  <packageSources>
    <add key="WireFlow LocalPackages" value="LocalPackages" />
  </packageSources>
</configuration>
